{
  "name": "vsmarketplace-badges",
  "publisher": "XuangeAha",
  "displayName": "VSMarketplace Badges",
  "description": "Insert version, installs and rating badges for VSMarketplace extensions easily to your HTML or Markdown pages.",
  "version": "2026.2.0",
  "license": "MIT",
  "icon": "logo.png",
  "author": {
    "name": "KamaoKat"
  },
  "homepage": "https://github.com/KamaoKat/VSMarketplace-Badges",
  "repository": {
    "type": "git",
    "url": "https://github.com/KamaoKat/VSMarketplace-Badges"
  },
  "bugs": {
    "url": "https://github.com/KamaoKat/VSMarketplace-Badges/issues"
  },
  "galleryBanner": {
      "color": "#87CEFA",
      "theme": "light"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "VSMarketplace",
    "visual studio",
    "marketplace",
    "extension",
    "badge",
    "badges",
    "vscode",
    "html",
    "markdown"
  ],
  "main": "./src/extension",
  "activationEvents": [
    "onCommand:vsmarketplacebadges.addbadges"
	],
  "contributes": {
    "commands": [
      {
        "command": "vsmarketplacebadges.addbadges",
        "title": "Insert VSMarketplace Badges"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorTextFocus",
          "command": "vsmarketplacebadges.addbadges",
          "group": "2_main"
        }
      ]
    }
  }
}